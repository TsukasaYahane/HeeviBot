# HeeviBot 配置模板：复制成 .env 再填。所有密钥 / 人设 / QQ 号都只放在本地 .env，不进仓库。

# ================= QQ 侧：OneBot 11 正向 WebSocket（SnowLuma / LLBot 等） =================
# 端口用 15001 以上：Windows 的 TCP 动态端口段可能从 1024 开始，Hyper-V / WinNAT 每次开机会在里面随机保留几段，
# 落进去 OneBot 实现会 listen EACCES。
ONEBOT_WS_URL=ws://127.0.0.1:23211
# OneBot 实现里配置了 accessToken 才填（以 Authorization: Bearer 发送）
ONEBOT_ACCESS_TOKEN=
# 群里被 @ 时，回复是否「引用」原消息
QQ_BOT_QUOTE_REPLY=true

# ================= DeepSeek Harness（DSH） =================
# 每轮起一个无状态的 `dsh --profile <DSH_PROFILE> --json -` 子进程（输入走 stdin），上下文由记忆账本组装。
# 不填 = 默认安装位置 %LOCALAPPDATA%\Programs\DeepSeek Harness\DeepSeek Harness.exe（及其 app.asar 里的 cli.js）
DSH_EXE=
DSH_CLI_JS=
DSH_PROFILE=qqbot
# DSH 工作目录：放在用户目录下（DSH 沙箱要给它加 ACL，数据盘会报 SetNamedSecurityInfoW failed）
DSH_WORKDIR=~/.dsh/workspaces/qqbot
DSH_TIMEOUT_SECS=300
DSH_MAX_CONCURRENCY=3

# ================= 人设 / 回复 =================
# 人设只放本地。优先级：QQ_BOT_SYSTEM_PROMPT_FILE（如 ~/.dsh/persona/heevi.md）> QQ_BOT_SYSTEM_PROMPT（一行文本；
# 填 - 表示不附加，完全交给 DSH profile 的 persona）> 内置默认（简洁中文纯文本）
QQ_BOT_SYSTEM_PROMPT_FILE=
QQ_BOT_SYSTEM_PROMPT=
# 群里叫她的名字（不区分大小写，逗号分隔；没 @ 但叫了名字也算想插话的信号）
QQ_BOT_NAMES=
# 单条回复最大字符数（防御性截断）
QQ_BOT_MAX_REPLY_CHARS=1900
# 拟人化分条：一次回复最多拆成几条消息、按打字速度依次发（1 = 不拆；节能模式最多 2）
QQ_BOT_SPLIT_MAX_PARTS=6
# 日志目录（每日轮转 qqbot-hermes.YYYY-MM-DD.log）
QQ_BOT_LOG_DIR=logs

# ================= 主人 / 权限 / 运行模式 =================
# 超级用户（主人）QQ 号，逗号分隔：任意群可重置记忆、切模式、审批入群 / 好友、查 Codex
QQ_BOT_SUPERUSERS=
# 除群主 / 管理员外，额外允许在群里「重置记忆」的 QQ 号
QQ_BOT_RESET_ALLOWED_USERS=
# 默认运行模式：正常 / 节能 / 静默（首次启动用；之后以「模式 xx」切换、存在 logs/mode.txt 的为准）
QQ_BOT_MODE=正常

# ================= 内容审查 =================
# 擦边 / 色情 / 政治言论明确拒绝（关键词 + 审核模型复核）；摸头、贴贴这类普通亲昵不拦。拦截记录在 logs/moderation.jsonl
QQ_BOT_MODERATION_ENABLED=true
# 审核模型（OpenAI 兼容；base / key 不填沿用视觉模块的）
QQ_BOT_MODERATION_MODEL=google/gemini-3.1-flash-lite
QQ_BOT_MODERATION_BASE=
QQ_BOT_MODERATION_API_KEY=
# 审核模型不可用、而内容又可疑时：true = 按不当处理（宁可错拒）
QQ_BOT_MODERATION_FAIL_CLOSED=true

# ================= 心智系统（记忆账本 + 学习 + 内心 + WebUI） =================
QQ_BOT_MIND_ENABLED=true
# 心智 WebUI（只绑 127.0.0.1；0 = 不启动）
QQ_BOT_MIND_WEBUI_PORT=8090
# 本地数据目录：mind.db（记忆）、knowledge/（资料库）、stickers/（表情包）、zxreport/ 等，全部只在本地
QQ_BOT_MIND_DATA_DIR=mind_data
# 自我学习（表达风格 / 群黑话 / 好感度 / 人物画像）
QQ_BOT_MIND_LEARN_ENABLED=true

# 夜间整理（默认 04:30）：先按 QQ 号把各窗口的往来整合进「对这个人的长期印象」，
# 再把每个窗口当天的对话压成前情 + 记忆，然后释放未压缩区（每个窗口只留最近 20 条接话）
QQ_BOT_COMPACT_ENABLED=true
QQ_BOT_COMPACT_AT=04:30
QQ_BOT_COMPACT_MIN_MSGS=6
QQ_BOT_COMPACT_BUDGET_CHARS=2400

# 夜间自学：好奇心队列里的词按「是什么 → 为什么 → 怎么做 + 我的看法」一晚学一层（防营销号 / 投毒）
QQ_BOT_RESEARCH_ENABLED=true
QQ_BOT_RESEARCH_PER_NIGHT=3

# ================= 群聊主动插话 =================
# 本地算「兴趣分」决定要不要开口（0 token）：叫了名字 +5 · 问到资料库 +4 · 聊到记得的事 +2 · 有人提问 +1 ·
# 群里热闹 +1 · 发了图 +1 · 说话人很反感 −3。≥ 门槛马上插话（短冷却）；差 2 分以内 35% 概率；其它低概率随机
QQ_BOT_CHIME_ENABLED=true
QQ_BOT_CHIME_THRESHOLD=4
QQ_BOT_CHIME_HOT_COOLDOWN_SECS=90
QQ_BOT_CHIME_PROB=0.06
QQ_BOT_CHIME_COOLDOWN_SECS=300
QQ_BOT_CHIME_MIN_MSGS=5
# 每群每天上限：0 = 不限（插得越多冷却自动越长，每 20 次 +1 倍）
QQ_BOT_CHIME_MAX_PER_DAY=0
QQ_BOT_CHIME_QUIET=23:30-08:00
# 含图消息的插话概率
QQ_BOT_CHIME_IMAGE_PROB=0.25

# ================= 社交主动性 =================
QQ_BOT_SOCIAL_ENABLED=true
# 邀请人 / 申请人好感 ≥ 这个值就自己同意入群 / 加好友，否则私聊问主人（主人邀请总是同意）
QQ_BOT_INVITE_MIN_AFFINITY=60
QQ_BOT_MAX_GROUPS=20
# 主动小窗：只找好感高、聊过、几天没聊的好友；对方说「别私聊我」就永远不再找
QQ_BOT_DM_ENABLED=true
QQ_BOT_DM_MAX_PER_DAY=3
QQ_BOT_DM_MIN_AFFINITY=65
QQ_BOT_DM_GAP_DAYS=3
QQ_BOT_DM_HOURS=10:00-22:30
# 24 小时内被 ≥3 个人冒犯这么多次就想退群（先私聊主人确认；主人在的群不退；0 = 关）
QQ_BOT_LEAVE_AUTO_OFFENSES=8

# ================= 视觉：图片 / 表情包识别 =================
# OpenAI 兼容的多模态接口；anthropic/* 模型自动走 Anthropic Messages 协议
QQ_BOT_VISION_ENABLED=true
QQ_BOT_VISION_BASE=https://api.onehop.ai/v1
QQ_BOT_VISION_MODEL=google/gemini-3.1-flash-lite
QQ_BOT_VISION_FALLBACK_MODELS=minimax/minimax-m3
QQ_BOT_VISION_PRIMARY_RETRY_SECS=600
# 留空 = 视觉功能自动关闭（不影响聊天）
QQ_BOT_VISION_API_KEY=
QQ_BOT_VISION_MAX_BYTES=6000000
QQ_BOT_VISION_TIMEOUT_SECS=90

# ================= 表情包 =================
# 表情差分贴纸库（图片放在本地 mind_data/stickers，按文件名标签挑）
QQ_BOT_STICKER_ENABLED=true
QQ_BOT_STICKER_DIR=mind_data/stickers
QQ_BOT_STICKER_PROB=0.33
QQ_BOT_STICKER_MIRROR_PROB=0.6
QQ_BOT_STICKER_CHIME_PROB=0.4
QQ_BOT_STICKER_COOLDOWN_SECS=600
QQ_BOT_STICKER_MAX_PER_DAY=12
QQ_BOT_STICKER_QUIET=23:30-08:00
# 表情包制作（meme-generator 独立服务，meme_server\start.bat 启动；没开不影响 bot）
QQ_BOT_MEME_ENABLED=true
QQ_BOT_MEME_API=http://127.0.0.1:3233
# 关键词前缀：空 = 直接「摸 @某人」；设成 / 则只认「/摸」
QQ_BOT_MEME_PREFIX=
QQ_BOT_MEME_WITHOUT_AT=true
QQ_BOT_MEME_TIMEOUT_SECS=60

# ================= 本地知识库（攻略文档） =================
# 目录里的 .md / .txt 按标题切块，提问时 BM25 检索注入。Word 先转：python tools/docx_to_md.py <in.docx> <out.md>
QQ_BOT_KB_ENABLED=true
# 不填 = <QQ_BOT_MIND_DATA_DIR>/knowledge
QQ_BOT_KB_DIR=
QQ_BOT_KB_MIN_SCORE=3.0
QQ_BOT_KB_MIN_TERMS=1
QQ_BOT_KB_FULL_DOC_CHARS=12000
QQ_BOT_KB_TOP_K=3
QQ_BOT_KB_MAX_CHARS=1800

# ================= 插件 =================
# B 站链接 / 小程序卡片自动解析封面
QQ_BOT_BILI_AUTO=true
# 群聊日报（每天 00:01 汇总成图）
QQ_BOT_DIGEST_ENABLED=true
# 早报卡片（订阅的群 / 私聊每天定时推送）
QQ_BOT_ZX_ENABLED=true
QQ_BOT_ZX_HOUR=9
QQ_BOT_ZX_MINUTE=0
QQ_BOT_ZX_ICON=mind_data/zxreport/icon.png
# 电竞战报轮询间隔（秒）
QQ_BOT_ESPORT_POLL_SECS=300
# lolesports 网关公共 key（官网前端自带的公开 key，非机密）
LOL_API_KEY=0TvQnueqKa5mxJntVWt0w4LpLfEkrV1Ta8rQBb9Z

# ================= Codex 通路（主人查看 ChatGPT / Codex 额度与工程进度） =================
CODEX_STATUS_ENABLED=true
# 不填 = 优先用正在运行的 codex.exe，否则找桌面版安装目录里最新的
CODEX_BIN=
CODEX_STATUS_THREADS=5
